{
  "cmake.cmakePath": "cube-cmake",
  "cmake.configureArgs": [
    "-DCMAKE_COMMAND=cube-cmake"
  ],
  "stm32cube-ide-clangd.path": "cube",
  "stm32cube-ide-clangd.arguments": [
    "starm-clangd",
    "--query-driver=${env:CUBE_BUNDLE_PATH}/st-arm-clang/21.1.1+st.7/bin/starm-clang*",
    "--query-driver=${env:CUBE_BUNDLE_PATH}/st-arm-clang/21.1.1+st.7/bin/starm-clang++*"
  ],
  "clangd.arguments": [
    "--resource-dir=/home/samuel/.local/share/stm32cube/bundles/st-arm-clang/21.1.1+st.7/lib/clang/21/"
  ],
  "cmake.preferredGenerators": [
    "Ninja"
  ],
  "ROS2.distro": "lyrical",
  "python.autoComplete.extraPaths": [
    "/opt/ros/lyrical/opt/sdformat_vendor/lib/python",
    "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
    "/opt/ros/lyrical/lib/python3.14/site-packages"
  ],
  "python.analysis.extraPaths": [
    "/opt/ros/lyrical/opt/sdformat_vendor/lib/python",
    "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
    "/opt/ros/lyrical/lib/python3.14/site-packages"
  ]
}